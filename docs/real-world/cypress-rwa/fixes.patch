 app.use(bodyParser.urlencoded({ extended: false }));
 app.use(bodyParser.json());
 
+// Browsers treat http://localhost as a secure context and accept Secure cookies from it,
+// so let express-session issue the Secure session cookie there too (it otherwise only does over TLS).
+app.use((req, _res, next) => {
+  if (req.hostname === "localhost" || req.hostname === "127.0.0.1") {
+    Object.defineProperty(req, "secure", { value: true });
+  }
+  next();
+});
+
 app.use(
   session({
     secret: "session secret",
     resave: false,
     saveUninitialized: false,
     unset: "destroy",
+    cookie: { httpOnly: true, secure: true },
   })
 );
 app.use(passport.initialize());
